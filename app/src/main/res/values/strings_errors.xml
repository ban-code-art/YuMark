    <string name="export_error_dir_not_writable">导出目录不可写，请检查存储空间后重试</string>

    <!--
      ==== WebDAV HTTP 失败：data.remote.webdav.WebDavClient ====
      401/403 单独成句：这两种情况服务器**是**连上了，说「连接失败」会把用户推去查网络，
      而真正要改的是账号密码。响应体一律不回显——WebDAV 的错误页动辄是一整篇 HTML。
    -->
    <string name="webdav_error_unauthorized">账号或密码不正确（HTTP 401）</string>
    <string name="webdav_error_forbidden">账号无权访问该目录（HTTP 403）</string>
    <string name="webdav_error_insufficient_storage">远端空间不足或文件过大（HTTP %1$d）</string>
    <!--
      下面四条各自指向一件用户能做的事，所以不能落到「上传失败：HTTP 412」那种兜底文案上：
      409 要去建上级目录、412 什么都不用做（下次同步自会按冲突处理）、423/429 是等一会儿再来。
    -->
    <string name="webdav_error_conflict_path">远端路径不可用（HTTP 409）：上级目录不存在，或同名位置已被一个文件占用</string>
    <string name="webdav_error_precondition_failed">远端文件刚被其他设备改动（HTTP 412），本次已跳过，下次同步会按冲突处理</string>
    <string name="webdav_error_locked">远端文件被锁定（HTTP 423），请稍后重试</string>
    <string name="webdav_error_rate_limited">请求过于频繁，已被服务器限流（HTTP 429），请稍后重试</string>
    <!-- 兜底：作为 error_action_failed 的「原因」半句使用，故这里只出状态码 -->
    <string name="webdav_error_http_status">HTTP %1$d</string>

    <!--
      ==== 升级包校验：core.update.ApkVerification / ApkDownloader ====
      四条都以「已删除该文件」收尾：校验不通过的包会被就地删掉，用户不必自己去清。
      包名那条回显实际包名（%1$s）——那是唯一能说明「这是别人的包」的证据。
    -->
    <string name="update_error_digest_mismatch">安装包校验失败：内容摘要与发布方公布的不一致，已删除该文件</string>
    <string name="update_error_package_mismatch">安装包校验失败：这不是本应用的安装包（包名 %1$s），已删除该文件</string>
    <string name="update_error_signer_mismatch">安装包校验失败：签名证书与已安装版本不一致，可能被篡改，已删除该文件</string>
    <string name="update_error_unreadable">安装包校验失败：文件无法解析成 APK，已删除该文件</string>
    <!--
      下载本身的失败（与上面四条「下到了但不可信」区分开）。
      %2$s 收的是最后一个候选源的真实原因（校验结论或已脱敏的异常原文），不是「都连不上」那种
      笼统话——「签名不一致」和「网络不通」要用户做的事完全不同。
    -->
    <string name="update_error_storage_unavailable">无法访问存储空间，请检查存储状态后重试</string>
    <string name="update_error_download_failed">下载失败</string>
    <string name="update_error_all_sources_failed">下载失败（已尝试 %1$d 个源）：%2$s</string>
    <!-- 安装器拒绝安装：包名/签名在拉起安装界面前又校验了一次（见 ApkDownloader.installApk） -->
    <string name="update_error_install_refused">已阻止安装：%1$s</string>
    <!--
      拉起安装界面这一步自己的失败。与上面的「校验不过」分开：这三条都不是安装包的问题，
      而是路径、文件已不在、或 startActivity 抛了异常。
