<?xml version="1.0" encoding="utf-8"?>
<!--
  错误文案集中地。

  产出侧全在 core（ErrorHandler / AiErrorMapper / WebViewFailure），那三处拿不到 Context，
  只持有这里的资源 id 与实参（见 core.util.UiMessage），解析发生在 presentation.common.resolve。
  单独成一个文件是为了让并行改动不撞车：res/values 下所有 resources 节点会被合并进同一个 R 命名空间。
-->
<resources>

    <!-- ==== 失败原因：AppError 的六个分类，与 ErrorMessages 一一对应 ==== -->
    <string name="error_reason_network">网络连接失败，请检查网络</string>
    <string name="error_reason_timeout">网络请求超时，请检查网络后重试</string>
    <string name="error_reason_storage">无法读写文件，请检查存储空间后重试</string>
    <string name="error_reason_database">本地数据访问异常，请重试</string>
    <string name="error_reason_permission">路径不合法或权限不足，操作已被拒绝</string>
    <string name="error_reason_unknown">出现未知问题，请重试</string>

    <!-- 「动作」失败：「原因」。两段实参在解析时已各自变成字符串，故都用 %s。 -->
    <string name="error_action_failed">%1$s失败：%2$s</string>

    <!-- ==== AI 请求失败：AiErrorMapper 的映射表，刻意不回显响应体原文 ==== -->
    <string name="ai_error_http_401">API Key 无效或已过期，请在设置中检查</string>
    <string name="ai_error_http_403">无访问权限，请检查 API Key 与账户权限</string>
    <string name="ai_error_http_404">接口地址不存在，请检查 Base URL</string>
    <string name="ai_error_http_400">请求格式错误，模型或参数可能有误</string>
    <string name="ai_error_http_429">请求过于频繁，已被限流，请稍后重试</string>
    <string name="ai_error_http_server">AI 服务暂时不可用（HTTP %1$d），请稍后重试</string>
    <string name="ai_error_http_other">请求失败（HTTP %1$d）</string>
    <!-- 唯一保留异常原文的分支：原文已由 ErrorHandler.safeDetail 脱敏、压平、截断 -->
    <string name="ai_error_unknown_detail">发生未知错误：%1$s</string>
    <string name="ai_error_not_configured">请先在设置中配置 API Key 和模型</string>
    <string name="ai_error_empty_response">AI 没有返回任何内容。可能是所选模型不支持本次请求、max tokens 过小，或为推理模型（正文在 reasoning 字段）。请重试，或在设置里更换模型 / 调大 max tokens。</string>
    <!--
      被内容策略拦下、因此一个字都没产出（三家的信号见 data.ai.isBlockedStopReason）。
      与上面那条空响应文案必须分开，理由是补救办法相反：那句让人去换模型 / 调大 max tokens，
      这里该做的是改写措辞——照那句做一遍，用户会先把 max tokens 调到顶再换一个模型，
      然后撞上同一堵墙。%1$s 是服务商给的原因原词（SAFETY / content_filter / RECITATION…），
      经 presentableBlockReason 净化后原样保留：它是用户唯一能拿去搜服务商文档的线索。
    -->
    <string name="ai_error_content_blocked">本次请求被模型的内容策略拦下，没有生成任何回复。请改写措辞后重试，或在设置里更换模型。</string>
    <string name="ai_error_content_blocked_reason">本次请求被模型的内容策略拦下（%1$s），没有生成任何回复。请改写措辞后重试，或在设置里更换模型。</string>
    <!-- Agent 收敛时文本里有 [[ACTION]] 但解析不出可应用的改动 -->
    <string name="agent_notice_bad_action_block">AI 输出的操作块格式有误，未生成可应用的改动</string>
    <!-- 服务端 stop reason 为 length / max_tokens / MAX_TOKENS：回复写到一半被上限砍断。
         Agent 侧此时还会拒绝把这段半截正文覆盖到已有文档上，所以文案要点明「未改动文档」。 -->
    <string name="ai_notice_response_truncated">回复被输出上限截断，未写完（已保留现有内容、未改动文档）。请在设置里调大 max tokens 后重试，或让 AI 分几次输出。</string>

