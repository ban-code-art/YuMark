    <string name="update_error_install_bad_path">安装失败：路径无效</string>
    <string name="update_error_install_missing_file">安装失败：安装包已不存在，请重新下载</string>
    <!-- %1$s 已由 ErrorHandler.safeDetail 脱敏、压平、截断 -->
    <string name="update_error_install_failed_detail">安装失败：%1$s</string>

    <!-- ==== SAF 打开失败：用户选的位置当场就不可读/不可写 ==== -->
