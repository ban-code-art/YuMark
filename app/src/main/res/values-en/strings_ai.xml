<?xml version="1.0" encoding="utf-8"?>
<!--
    AI / Agent 模块文案（英文语区）。

    维护规则（与 values-en/strings.xml 一致，必须遵守）：
    1. 键名、顺序、分节注释与 values/strings_ai.xml 逐行对齐，方便对照。
    2. 新增或删除任何键必须同时改两边。只在一边加键会触发 lint 的 MissingTranslation，
       本项目无 lint.xml、无 baseline，它是 error 级，会直接卡住构建。
    3. 占位符的数量、类型、位置写法两边必须一致（一律 %1$s / %1$d），
       否则 lint 报 StringFormatInvalid / StringFormatMatches。
    4. <plurals> 英文必须同时有 one 与 other（缺 other 报 MissingQuantity）。
    5. 省略号一律写成单字符 …（U+2026），不要写三个点 —— lint 的 TypographyEllipsis
       盯的就是后者。撇号一律避开或写成 \'，否则 aapt2 直接报错。
    6. 文案用 sentence case；按钮用动词原形。
    7. 品牌与技术标识不翻：Agent / OpenAI / Anthropic Claude / Google Gemini /
       DuckDuckGo / Tavily / Serper / Brave / RAG / token。
-->
<resources>

    <!-- ========== Agent 任务 / 步骤 / 操作状态标签 AiDesign.kt ==========
         任务级 Completed 与步骤级 Done 刻意用两个词，与中文侧「已完成 / 完成」的
         区分对齐；共用一个键会让其中一处读起来不对。 -->
    <string name="ai_task_status_planning">Planning</string>
    <string name="ai_task_status_executing">Executing</string>
    <string name="ai_task_status_replanning">Replanning</string>
    <string name="ai_task_status_blocked">Blocked</string>
    <string name="ai_task_status_completed">Completed</string>
    <string name="ai_task_status_failed">Failed</string>

    <string name="ai_step_status_pending">Pending</string>
    <string name="ai_step_status_running">Running</string>
    <string name="ai_step_status_done">Done</string>
    <string name="ai_step_status_blocked">Blocked</string>
    <string name="ai_step_status_failed">Failed</string>
    <string name="ai_step_status_skipped">Skipped</string>

    <!-- Applied（而不是 Executed）：这一组说的是 diff 审阅的结果 -->
    <string name="ai_action_status_pending">Pending review</string>
    <string name="ai_action_status_approved">Approved</string>
    <string name="ai_action_status_rejected">Rejected</string>
    <string name="ai_action_status_executed">Applied</string>

    <!-- ========== 工具调用旁白 ToolActivityRow.narrateTool ==========
         同一句既出现在「正在执行」也出现在「已完成」的行里，所以用时态中立的动词原形，
         不写 Reading / Read the document。when 的键是 function name，不在本文件里。 -->
    <string name="ai_tool_read_document">Read document</string>
    <string name="ai_tool_search_in_project">Search project</string>
    <string name="ai_tool_list_documents">Browse documents</string>

    <!-- ========== 逐块 diff 审阅 DiffView ==========
         %1$d = hunk 序号（从 1 起），是序号不是数量，故不做 plurals。 -->
    <string name="ai_diff_hunk_apply">Apply change #%1$d</string>
    <string name="ai_diff_hunk_keep">Keep original #%1$d</string>

    <!-- ========== Agent 状态小圆点 AgentStatusIndicator ==========
         IDLE 两个语区都是 "Agent"：读屏播报的是产品里这个功能的名字。 -->
    <string name="cd_agent_status_idle">Agent</string>
    <string name="cd_agent_status_working">Agent working</string>
    <string name="cd_agent_status_completed">Completed</string>

    <!-- ========== 执行流程时间轴 AgentTimeline ========== -->
    <string name="agent_timeline_task_label">Task</string>
    <string name="cd_agent_timeline_expand">Show execution steps</string>
    <string name="cd_agent_timeline_collapse">Hide execution steps</string>
    <!-- %1$d = 被折叠掉的步骤数。中文侧用全宽＋，英文侧用半宽 + 才不至于突兀。 -->
    <plurals name="agent_timeline_more_steps">
        <item quantity="one">+%1$d more step</item>
        <item quantity="other">+%1$d more steps</item>
    </plurals>
    <string name="agent_timeline_note_blocked">Blocked</string>
    <string name="agent_timeline_note_result">Result</string>

    <!-- ========== 阻塞原因 / 结果摘要 ==========
         落库的是 AgentStatusCode 稳定码，不是这里的文案；认不出的值按原文透出。 -->
    <string name="agent_blocked_empty_response">The model returned no content</string>
    <string name="agent_blocked_duplicate_tool_call">Repeated tool call detected</string>
